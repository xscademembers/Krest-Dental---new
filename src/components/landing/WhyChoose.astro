---
import LandingIcon from "@/components/landing/LandingIcon.astro";
import SectionHeading from "@/components/landing/SectionHeading.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["whyChoose"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-cream" } = Astro.props;
---

<section class={`${sectionBg} py-16 lg:py-20`} aria-label={data.heading}>
  <div class="krest-site">
    <SectionHeading heading={data.heading} intro={data.intro} />

    <ul class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
      {data.cards.map((card) => (
        <li class="flex gap-4 rounded-[20px] bg-white p-6 shadow-[0_18px_44px_-32px_rgba(63,42,32,0.5)]">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#F4EAE6] text-copper">
            <LandingIcon name={card.icon} class="h-[22px] w-[22px]" />
          </span>
          <div>
            <h3 class="font-display text-[19px] leading-tight text-ink">{card.title}</h3>
            {card.text && (
              <p class="mt-1.5 font-body text-[14px] leading-relaxed text-taupe">{card.text}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
