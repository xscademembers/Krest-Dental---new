---
import LandingIcon from "@/components/landing/LandingIcon.astro";
import SectionHeading from "@/components/landing/SectionHeading.astro";
import TextWithDrSuneetaHighlight from "@/components/TextWithDrSuneetaHighlight.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["whyChoose"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-pure-white" } = Astro.props;

// Cinematic images for the stacking cards
const images = [
  "/images/dr-suneeta/hero-portrait.jpg",
  "/images/invisilign-old/invisalign-consultation.jpg",
  "/images/invisilign-old/studio-portrait.jpg",
  "/images/dr-suneeta/hero-portrait.jpg",
  "/images/invisilign-old/getty-man.jpg",
  "/images/invisilign-old/invisalign-consultation.jpg",
];
---

<section class={`${sectionBg} relative py-24 lg:py-[120px]`} aria-label={data.heading}>
  <div class="krest-site">
    <SectionHeading heading={data.heading} intro={data.intro} />

    <!-- Stacking Sticky Cards Layout -->
    <div class="mt-20 flex flex-col gap-6 lg:gap-12 pb-16 lg:pb-32">
      {data.cards.map((card, index) => {
        // Alternate layout for visual rhythm
        const isEven = index % 2 === 1;
        // Calculate sticky top offset to create the cascading stack effect
        // Base offset is 100px (header clearance), plus 40px for each subsequent card
        const stickyTop = 100 + (index * 40);

        return (
          <div 
            class={`sticky z-10 flex w-full flex-col overflow-hidden rounded-[40px] bg-white shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)] ring-1 ring-black/5 transition-all duration-500 hover:shadow-[0_-10px_60px_-15px_rgba(159,100,73,0.2)] lg:flex-row ${isEven ? 'lg:flex-row-reverse' : ''}`}
            style={`top: ${stickyTop}px;`}
            data-float-in="up"
          >
            <!-- Image Side -->
            <div class="relative w-full overflow-hidden lg:w-1/2">
              <img 
                src={images[index]} 
                alt={card.title}
                class="h-[340px] w-full object-cover transition-transform duration-1000 hover:scale-105 sm:h-[400px] lg:h-[540px]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            </div>

            <!-- Content Side -->
            <div class="flex w-full flex-col justify-center bg-white p-10 sm:p-14 lg:w-1/2 lg:p-20">
              <div class="flex items-center gap-6">
                <div class="font-accent text-[18px] font-bold tracking-[0.2em] text-copper/30">
                  0{index + 1}
                </div>
                <div class="h-px flex-1 bg-border/50"></div>
              </div>

              <div class="mt-10 flex h-16 w-16 items-center justify-center rounded-[20px] bg-cream text-copper shadow-sm">
                <LandingIcon name={card.icon} class="h-7 w-7" />
              </div>
              
              <h3 class="mt-8 font-display text-[32px] font-medium leading-[1.1] text-ink sm:text-[42px]">
                {card.title}
              </h3>
              
              <p class="mt-6 max-w-lg font-body text-[18px] leading-[1.7] text-taupe">
                <TextWithDrSuneetaHighlight text={card.text ?? ""} />
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- CTA Button -->
    <div class="mt-8 flex justify-center" data-float-in="up">
      <a
        href="#lead-form"
        class="inline-flex h-[56px] items-center justify-center rounded-full bg-copper px-8 font-body text-[16px] font-semibold text-white shadow-[0_12px_28px_-10px_rgba(159,100,73,0.6)] transition-all hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-10px_rgba(159,100,73,0.8)]"
      >
        Book Consultation
      </a>
    </div>

  </div>
</section>
