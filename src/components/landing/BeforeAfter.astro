---
import SectionHeading from "@/components/landing/SectionHeading.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["beforeAfter"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-cream" } = Astro.props;
---

<section class={`${sectionBg} py-16 lg:py-20`} aria-label={data.heading}>
  <div class="krest-site">
    <SectionHeading heading={data.heading} intro={data.intro} />

    <div class="mt-10 grid grid-cols-1 gap-8 lg:mt-12 lg:grid-cols-2 lg:gap-10">
      {data.items.map((item) => (
        <figure>
          <div
            class="ba-compare relative aspect-[4/3] w-full select-none overflow-hidden rounded-[24px] shadow-[0_24px_60px_-34px_rgba(63,42,32,0.55)]"
            data-ba
          >
            <!-- After (base layer) -->
            <img
              src={item.after}
              alt={`${item.alt} — after`}
              class="pointer-events-none absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-copper px-3 py-1 font-body text-[11px] font-semibold uppercase tracking-wide text-white">
              After
            </span>

            <!-- Before (clipped overlay) -->
            <div class="ba-before pointer-events-none absolute inset-0 h-full w-full overflow-hidden" style="width:50%">
              <img
                src={item.before}
                alt={`${item.alt} — before`}
                class="absolute inset-0 h-full w-full max-w-none object-cover"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute left-3 top-3 rounded-full bg-ink/70 px-3 py-1 font-body text-[11px] font-semibold uppercase tracking-wide text-white">
                Before
              </span>
            </div>

            <!-- Handle -->
            <div class="ba-handle pointer-events-none absolute inset-y-0 z-10 w-0.5 bg-white" style="left:50%">
              <span class="absolute top-1/2 left-1/2 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-copper shadow-md">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 6l-6 6 6 6 M15 6l6 6-6 6" />
                </svg>
              </span>
            </div>

            <input
              type="range"
              min="0"
              max="100"
              value="50"
              aria-label={`Compare before and after: ${item.alt}`}
              class="ba-range absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
            />
          </div>
          {item.label && (
            <figcaption class="mt-3 text-center font-body text-[14px] text-taupe">{item.label}</figcaption>
          )}
        </figure>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-ba]").forEach(function (root) {
      var range = root.querySelector(".ba-range");
      var before = root.querySelector(".ba-before");
      var handle = root.querySelector(".ba-handle");
      if (!range || !before || !handle) return;
      function update() {
        var v = range.value + "%";
        before.style.width = v;
        handle.style.left = v;
      }
      range.addEventListener("input", update);
      update();
    });
  })();
</script>
