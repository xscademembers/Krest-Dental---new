---
import SectionHeading from "@/components/landing/SectionHeading.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["beforeAfter"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-pure-white" } = Astro.props;
---

<section class={`${sectionBg} py-24 lg:py-[120px]`} aria-label={data.heading}>
  <div class="krest-site">
    <SectionHeading heading={data.heading} intro={data.intro} />

    <div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16" data-float-in="up">
      {data.items.map((item) => (
        <div class="group flex flex-col gap-6">
          <div class="relative overflow-hidden rounded-[32px] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] ring-1 ring-border/50 transition-transform duration-500 group-hover:-translate-y-1">
            <!-- Side by side Before / After -->
            <div class="flex w-full divide-x-4 divide-white">
              <!-- Before -->
              <div class="relative w-1/2 overflow-hidden">
                <img 
                  src={item.before} 
                  alt={`Before: ${item.alt}`}
                  class="h-[260px] w-full object-cover transition-transform duration-700 group-hover:scale-105 sm:h-[340px]"
                  loading="lazy"
                />
                <div class="absolute bottom-4 left-4 rounded-full bg-black/60 px-4 py-1.5 font-display text-[14px] tracking-wide text-white backdrop-blur-md">
                  Before
                </div>
              </div>
              <!-- After -->
              <div class="relative w-1/2 overflow-hidden bg-cream">
                <img 
                  src={item.after} 
                  alt={`After: ${item.alt}`}
                  class="h-[260px] w-full object-cover transition-transform duration-700 group-hover:scale-105 sm:h-[340px]"
                  loading="lazy"
                />
                <div class="absolute bottom-4 right-4 rounded-full bg-copper px-4 py-1.5 font-display text-[14px] tracking-wide text-white shadow-md backdrop-blur-md">
                  After
                </div>
              </div>
            </div>
          </div>
          
          <h3 class="text-center font-display text-[22px] font-medium text-ink transition-colors group-hover:text-copper">
            {item.label}
          </h3>
        </div>
      ))}
    </div>
  </div>
</section>
