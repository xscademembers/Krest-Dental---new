---
import LandingIcon from "@/components/landing/LandingIcon.astro";
import SectionHeading from "@/components/landing/SectionHeading.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["testimonials"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-pure-white" } = Astro.props;
---

<section class={`${sectionBg} py-24 lg:py-[120px]`} aria-label={data.heading}>
  <div class="krest-site">
    <SectionHeading heading={data.heading} intro={data.intro} />

    <!-- Overall Rating Badge -->
    <div class="mt-10 flex justify-center" data-float-in="up">
      <div class="flex items-center gap-4 rounded-full bg-white px-6 py-3 shadow-[0_8px_16px_-6px_rgba(0,0,0,0.1)] ring-1 ring-black/5">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#F8F9FA] shadow-sm">
          <!-- Google 'G' Logo -->
          <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1 text-[#FABB05] text-[15px]">
            <span>★★★★★</span>
          </div>
          <p class="font-body text-[13px] font-medium text-ink">5.0 Rating • 500+ Reviews</p>
        </div>
      </div>
    </div>

    <!-- Masonry Grid for varied heights -->
    <div class="mt-16 columns-1 gap-6 sm:columns-2 lg:columns-3" data-float-in="up">
      {data.reviews.map((review) => (
        <div class="mb-6 break-inside-avoid rounded-[28px] bg-white p-8 shadow-[0_12px_32px_-12px_rgba(0,0,0,0.06)] ring-1 ring-border/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)]">
          
          <div class="flex items-start justify-between">
            <div class="flex text-[#FABB05] text-[18px]">
              {"★".repeat(review.rating ?? 5)}
            </div>
            <!-- Google 'G' Logo small -->
            <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>

          <p class="mt-6 font-body text-[16px] leading-[1.7] text-taupe">
            "{review.quote}"
          </p>

          <div class="mt-8 flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-cream font-display text-[18px] font-semibold text-copper">
              {review.author.charAt(0)}
            </div>
            <div>
              <p class="font-display text-[18px] font-medium leading-none text-ink">
                {review.author}
              </p>
              <div class="mt-2 flex items-center gap-1.5">
                <LandingIcon name="check" class="h-3.5 w-3.5 text-green-600" />
                <p class="font-body text-[13px] text-taupe">Verified Patient</p>
                <span class="text-[10px] text-taupe/50">•</span>
                <p class="font-body text-[13px] text-taupe">2 weeks ago</p>
              </div>
            </div>
          </div>
          
        </div>
      ))}
    </div>
  </div>
</section>
