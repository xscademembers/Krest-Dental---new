---
import LandingIcon from "@/components/landing/LandingIcon.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["leadForm"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-pure-white" } = Astro.props;
---

<section id="lead-form" class={`${sectionBg} py-24 lg:py-[120px]`} aria-label="Book Consultation">
  <div class="krest-site mx-auto max-w-[1069px]">
    
    <div class="relative overflow-hidden rounded-[32px] bg-copper shadow-[0_30px_70px_-20px_rgba(63,42,32,0.4)] ring-1 ring-black/5" data-float-in="up">
      <!-- Decorative background pattern -->
      <div class="pointer-events-none absolute inset-0 opacity-10">
        <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid-pattern)" />
        </svg>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5">
        
        <!-- Left: Copy & Trust Signals -->
        <div class="relative z-10 flex flex-col justify-center p-10 lg:col-span-2 lg:p-14 lg:pr-8">
          <h2 class="font-display text-[36px] font-medium leading-[1.1] text-white sm:text-[42px]">
            {data.heading}
          </h2>
          <p class="mt-4 font-body text-[18px] leading-[1.6] text-white/80">
            {data.intro}
          </p>

          <div class="mt-12 space-y-6 border-t border-white/20 pt-8">
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 backdrop-blur-sm">
                <LandingIcon name="star" class="h-5 w-5 text-white" />
              </div>
              <p class="font-body text-[15px] font-medium text-white">5.0 Google Rated Clinic</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 backdrop-blur-sm">
                <LandingIcon name="phone" class="h-5 w-5 text-white" />
              </div>
              <p class="font-body text-[15px] font-medium text-white">Fast Response (Under 15 mins)</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 backdrop-blur-sm">
                <LandingIcon name="check" class="h-5 w-5 text-white" />
              </div>
              <p class="font-body text-[15px] font-medium text-white">100% Privacy. No Spam.</p>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="relative z-10 p-4 lg:col-span-3 lg:p-10">
          <div class="rounded-[24px] bg-white p-8 shadow-lg sm:p-10">
            <form id="landing-lead-form" class="flex flex-col gap-5">
              <input type="hidden" name="interest" value={data.interest} />
              
              <div>
                <label for="name" class="sr-only">Full Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Full Name"
                  class="contact-field h-14 w-full px-5 font-body text-[16px] transition-colors"
                />
              </div>

              <div>
                <label for="phone" class="sr-only">Phone Number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="Phone Number"
                  class="contact-field h-14 w-full px-5 font-body text-[16px] transition-colors"
                />
              </div>

              <div class="relative">
                <label for="preferredTime" class="sr-only">Preferred Time to Call</label>
                <select
                  id="preferredTime"
                  name="preferredTime"
                  class="contact-field h-14 w-full appearance-none bg-white px-5 font-body text-[16px] transition-colors"
                  required
                >
                  <option value="" disabled selected>Preferred Time to Call</option>
                  <option value="morning">Morning (9 AM - 12 PM)</option>
                  <option value="afternoon">Afternoon (12 PM - 4 PM)</option>
                  <option value="evening">Evening (4 PM - 8 PM)</option>
                  <option value="anytime">Anytime</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-5 flex items-center">
                  <LandingIcon name="check" class="h-4 w-4 rotate-90 text-taupe" />
                </div>
              </div>

              <button
                type="submit"
                data-track="form_submit"
                data-track-label="lead_form_bottom"
                class="contact-submit mt-4 h-14 w-full font-body text-[16px] font-semibold transition-all hover:-translate-y-0.5"
              >
                <span>{data.submitLabel}</span>
              </button>

              <div id="form-message" class="mt-2 hidden text-center font-body text-[14px]"></div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("landing-lead-form") as HTMLFormElement;
  const messageEl = document.getElementById("form-message");

  if (form && messageEl) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.innerHTML;
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = "<span>Sending...</span>";
      messageEl.className = "mt-2 hidden text-center font-body text-[14px]";
      
      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        // This assumes an API route exists at /api/leads
        const response = await fetch("/api/leads", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          form.reset();
          messageEl.textContent = "Thank you! We will contact you shortly.";
          messageEl.className = "mt-2 text-center font-body text-[14px] text-green-600 block";
        } else {
          throw new Error("Failed to submit");
        }
      } catch (error) {
        messageEl.textContent = "Something went wrong. Please try calling us.";
        messageEl.className = "mt-2 text-center font-body text-[14px] text-red-600 block";
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }
</script>
