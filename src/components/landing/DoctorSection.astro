---
import LandingIcon from "@/components/landing/LandingIcon.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["doctor"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-white" } = Astro.props;
---

<section class={`${sectionBg} py-16 lg:py-20`} aria-label={data.heading}>
  <div class="krest-site grid grid-cols-1 items-center gap-10 lg:grid-cols-[420px_1fr] lg:gap-14">
    <div class="order-1">
      <div class="overflow-hidden rounded-[28px] shadow-[0_30px_70px_-30px_rgba(63,42,32,0.5)]">
        <img
          src={data.image}
          alt={data.imageAlt}
          width="640"
          height="720"
          loading="lazy"
          decoding="async"
          class="h-[380px] w-full object-cover object-top sm:h-[460px]"
        />
      </div>
    </div>

    <div class="order-2">
      <p class="font-accent text-[12px] uppercase tracking-[0.24em] text-copper">{data.heading}</p>
      <h2 class="mt-3 font-display text-[30px] font-normal leading-tight text-ink sm:text-[38px]">
        {data.name}
      </h2>
      <p class="mt-1.5 font-accent text-[15px] text-copper">{data.role}</p>
      <p class="mt-5 max-w-[560px] font-body text-[15px] leading-relaxed text-taupe sm:text-[16px]">
        {data.bio}
      </p>

      <ul class="mt-7 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {data.highlights.map((h) => (
          <li class="flex items-center gap-2.5 font-body text-[14px] text-ink">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-copper/10 text-copper">
              <LandingIcon name="check" class="h-4 w-4" />
            </span>
            {h}
          </li>
        ))}
      </ul>

      <a
        href={data.cta.href}
        data-track="book_click"
        data-track-label="doctor_cta"
        class="mt-8 inline-flex h-[52px] items-center justify-center rounded-full bg-copper px-8 font-body text-[15px] font-semibold text-white transition hover:opacity-90"
      >
        {data.cta.label}
      </a>
    </div>
  </div>
</section>
