---
import SectionHeading from "@/components/landing/SectionHeading.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["process"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-white" } = Astro.props;
---

<section class={`${sectionBg} py-16 lg:py-20`} aria-label={data.heading}>
  <div class="krest-site">
    <SectionHeading heading={data.heading} intro={data.intro} />

    <ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {data.steps.map((step, i) => (
        <li class="relative flex flex-col items-center rounded-[22px] bg-cream px-6 py-8 text-center">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-copper font-display text-[20px] text-white">
            {i + 1}
          </span>
          <h3 class="mt-5 font-display text-[20px] leading-tight text-ink">{step.title}</h3>
          {step.text && (
            <p class="mt-3 font-body text-[14px] leading-relaxed text-taupe">{step.text}</p>
          )}
          {i < data.steps.length - 1 && (
            <span
              aria-hidden="true"
              class="absolute -right-3 top-1/2 hidden -translate-y-1/2 text-copper lg:block"
            >
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14 M13 6l6 6-6 6" />
              </svg>
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
