---
import SectionHeading from "@/components/landing/SectionHeading.astro";
import type { LandingContent } from "@/types/landing";

interface Props {
  data: LandingContent["process"];
  sectionBg?: string;
}

const { data, sectionBg = "bg-pure-white" } = Astro.props;
---

<section class={`${sectionBg} py-24 lg:py-[120px]`} aria-label={data.heading}>
  <div class="krest-site">
    <SectionHeading heading={data.heading} intro={data.intro} />

    <!-- The Staggered Path Timeline -->
    <div class="mt-24 relative mx-auto max-w-6xl px-4 sm:px-0">
      
      <!-- Central Vertical Line (Desktop only) -->
      <div class="absolute bottom-0 left-1/2 top-0 hidden w-px -translate-x-1/2 bg-gradient-to-b from-copper/0 via-copper/30 to-copper/0 md:block"></div>

      {data.steps.map((step, index) => {
        const isEven = index % 2 === 1; // 0 is odd visually, 1 is even, etc.
        return (
          <div 
            class={`relative mb-16 flex flex-col items-center justify-between md:mb-24 md:flex-row ${isEven ? 'md:flex-row-reverse' : ''}`}
            data-float-in="up"
          >
             <!-- Mobile Connector Line -->
             {index !== data.steps.length - 1 && (
               <div class="absolute bottom-[-4rem] left-[3.5rem] top-[8rem] w-px bg-copper/20 md:hidden"></div>
             )}

             <!-- Central Node (Desktop) -->
             <div class="absolute left-1/2 top-1/2 z-10 hidden h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[24px] font-bold text-copper shadow-[0_12px_32px_-10px_rgba(159,100,73,0.4)] ring-8 ring-pure-white transition-transform duration-500 hover:scale-110 md:flex">
               0{index + 1}
             </div>

             <!-- Content Card -->
             <div class={`w-full md:w-[45%] ${isEven ? 'md:pl-16 lg:pl-24' : 'md:pr-16 lg:pr-24'}`}>
                <div class="group relative overflow-hidden rounded-[40px] bg-white p-10 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.06)] ring-1 ring-border/50 transition-all duration-700 hover:-translate-y-2 hover:shadow-[0_40px_80px_-20px_rgba(159,100,73,0.15)] hover:ring-copper/40 sm:p-14">
                  
                  <!-- Mobile Number -->
                  <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-cream text-[20px] font-bold text-copper md:hidden">
                    0{index + 1}
                  </div>
                  
                  <h3 class="mt-4 font-display text-[28px] font-medium leading-[1.1] text-ink transition-colors duration-500 group-hover:text-copper sm:text-[36px]">
                    {step.title}
                  </h3>
                  
                  <p class="mt-5 font-body text-[17px] leading-[1.7] text-taupe/90">
                    {step.text}
                  </p>
                </div>
             </div>
             
             <!-- Spacer for alternating layout -->
             <div class="hidden w-[45%] md:block"></div>
          </div>
        )
      })}
    </div>
  </div>
</section>
