---
import { DR_SUNEETA_NAME_WITH_CREDENTIAL } from "@/lib/krest-content";
import {
  DR_SUNEETA_HIGHLIGHT_CLASS,
  splitTextByDrSuneetaCredential,
  textContainsDrSuneetaCredential,
} from "@/lib/dr-suneeta-highlight";

interface Props {
  text: string;
  highlightClass?: string;
}

const { text, highlightClass = "" } = Astro.props;
const parts = textContainsDrSuneetaCredential(text)
  ? splitTextByDrSuneetaCredential(text)
  : [text];
---

{
  parts.length === 1 ? (
    text
  ) : (
    parts.map((part, index) => (
      <>
        {part}
        {index < parts.length - 1 ? (
          <span class:list={[DR_SUNEETA_HIGHLIGHT_CLASS, highlightClass]}>
            {DR_SUNEETA_NAME_WITH_CREDENTIAL}
          </span>
        ) : null}
      </>
    ))
  )
}
