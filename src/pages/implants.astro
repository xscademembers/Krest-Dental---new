---
import Layout from "@/layouts/Layout.astro";
import { FloatingCallButton } from "@/components/FloatingCallButton";
import { ImplantsMain } from "@/components/ImplantsMain";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";

const canonical = "https://www.krest.dental/implants";
const title = "Dental Implants in Vizag | Krest Dental";
const description =
  "Looking for Dental Implants? Discover advanced, long-lasting tooth replacement options, implant procedure steps, safety, and consultation at Krest Dental.";
const keywords = [
  "dental implants",
  "best dental implants",
  "cost of dental implants",
  "tooth replacement options",
  "permanent teeth replacement",
  "are dental implants safe",
  "dental implant procedure",
  "dental implants vizag",
  "implantologist visakhapatnam",
  "single tooth implant",
  "multiple teeth implants",
  "all-on-4 implants",
];
---

<Layout {title} {description} {canonical} ogType="article" {keywords}>
  <SiteHeader client:load />
  <ImplantsMain />
  <SiteFooter />
  <FloatingCallButton />
</Layout>
