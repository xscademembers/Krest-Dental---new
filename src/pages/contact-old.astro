---
import Layout from "@/layouts/Layout.astro";
import { ContactOldMain } from "@/components/ContactOldMain";
import { FloatingCallButton } from "@/components/FloatingCallButton";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";

export const prerender = true;

const canonical = "https://www.krest.dental/contact";
const title = "Contact (Original Page) | Krest Dental";
const description =
  "Original Contact page — discover the Krest difference. Book your consultation today and take the first step toward a healthier, more confident smile.";
const keywords = [
  "krest dental contact",
  "dentist visakhapatnam appointment",
  "dental clinic mvp colony",
  "book dental consultation vizag",
];
---

<Layout {title} {description} {canonical} {keywords}>
  <SiteHeader client:load />
  <ContactOldMain />
  <div class="contact-old-footer">
    <SiteFooter />
  </div>
  <FloatingCallButton />
</Layout>

<style>
  .contact-old-footer :global(footer) {
    background-color: #F4EAE6;
  }
</style>
