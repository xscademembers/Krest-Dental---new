---
import Layout from "@/layouts/Layout.astro";
import { FloatingCallButton } from "@/components/FloatingCallButton";
import { ImplantsOldMain } from "@/components/ImplantsOldMain";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";

export const prerender = true;

const canonical = "https://www.krest.dental/implants";
const title = "Dental Implants in Vizag (Original Page) | Krest Dental";
const description =
  "Original Implants page — natural-looking dental implants at Krest Dental, Visakhapatnam. Tailored implant solutions, expert-led care, and a step-by-step implants journey.";
const keywords = [
  "dental implants",
  "implants vizag",
  "implants visakhapatnam",
  "tooth replacement",
  "full arch restoration",
  "krest dental implants",
];
---

<Layout {title} {description} {canonical} ogType="article" {keywords}>
  <SiteHeader client:load />
  <ImplantsOldMain />
  <div class="implants-old-footer">
    <SiteFooter />
  </div>
  <FloatingCallButton />
</Layout>

<style>
  .implants-old-footer :global(footer) {
    background-color: #F4EAE6;
  }
</style>
