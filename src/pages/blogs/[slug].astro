---
import Layout from "@/layouts/Layout.astro";
import { FloatingCallButton } from "@/components/FloatingCallButton";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";
import { BLOG_POSTS } from "@/lib/krest-content";
import type { BlogPost } from "@/types/krest";

export const prerender = true;

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const canonical = `https://www.krest.dental/blogs/${post.slug}`;
const title = `${post.title} | Krest Dental`;
const description = post.excerpt;
const keywords = [post.category.toLowerCase(), "krest dental blog", "dentist visakhapatnam"];

const sortedPosts = [...BLOG_POSTS].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const related = sortedPosts.filter((p) => p.slug !== post.slug).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  datePublished: post.date,
  description: post.excerpt,
  image: post.cover.src,
  url: canonical,
  author: {
    "@type": "Organization",
    name: "Krest Dental",
    url: "https://www.krest.dental",
  },
  publisher: {
    "@type": "Organization",
    name: "Krest Dental",
    url: "https://www.krest.dental",
  },
  mainEntityOfPage: canonical,
};
---

<Layout {title} {description} {canonical} {keywords} ogType="article" ogImage={post.cover.src}>
  <SiteHeader client:load />
  <main class="flex-1 bg-cream">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <article>
      <header class="bg-[#F4EAE7] pb-10 pt-12 lg:pb-14 lg:pt-16">
        <div class="mx-auto max-w-[860px] px-[25px] text-center">
          <p class="font-accent text-[12px] uppercase tracking-[0.28em] text-copper">
            {post.category} · {post.readingTime}
          </p>
          <h1
            class="mt-4 font-display text-[34px] font-normal leading-[1.15] text-ink sm:text-[44px] lg:text-[50px]"
          >
            {post.title}
          </h1>
          <p
            class="mt-5 font-body text-[13px] uppercase tracking-[0.18em] text-taupe"
          >
            {dateFormatter.format(new Date(post.date))}
          </p>
        </div>
      </header>

      <div class="mx-auto max-w-[1080px] px-[25px] pt-10 lg:pt-14">
        <div
          class="overflow-hidden rounded-[20px] shadow-[0_22px_60px_-32px_rgba(0,0,0,0.35)] lg:rounded-[24px]"
        >
          <img
            src={post.cover.src}
            alt={post.cover.alt}
            class="aspect-[16/9] w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="mx-auto max-w-[760px] px-[25px] py-12 lg:py-16">
        <div class="space-y-6">
          {post.body.map((para) => (
            <p class="font-display text-[17px] leading-[1.8] text-ink sm:text-[18px]">{para}</p>
          ))}
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-copper/15 pt-8">
          <a
            href="/blogs"
            class="inline-flex items-center gap-2 font-display text-[15px] text-copper transition-colors hover:text-ink"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-3.5 w-3.5"
              aria-hidden="true"
            >
              <path d="M19 12H5" />
              <path d="M11 19l-7-7 7-7" />
            </svg>
            Back to all posts
          </a>
          <a
            href="/contact"
            class="inline-flex h-11 items-center rounded-full border border-copper bg-copper px-6 font-display text-[15px] text-white transition hover:bg-copper/90"
          >
            Book a consultation
          </a>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="border-t border-copper/15 bg-[#F4EAE7] py-14 lg:py-20" aria-label="Related posts">
        <div class="mx-auto max-w-[1240px] px-[25px]">
          <p class="font-accent text-[12px] uppercase tracking-[0.28em] text-copper">
            Continue reading
          </p>
          <h2
            class="mt-3 font-display text-[28px] font-normal leading-tight text-ink sm:text-[34px]"
          >
            More from the journal
          </h2>
          <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
            {related.map((p) => (
              <article
                class="flex h-full flex-col overflow-hidden rounded-[18px] bg-white shadow-[0_14px_38px_-26px_rgba(0,0,0,0.22)] transition hover:-translate-y-1"
              >
                <a href={`/blogs/${p.slug}`} class="group block">
                  <div class="relative aspect-[16/10] w-full overflow-hidden">
                    <img
                      src={p.cover.src}
                      alt={p.cover.alt}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </a>
                <div class="flex flex-1 flex-col px-6 pb-6 pt-5">
                  <p class="font-accent text-[11px] uppercase tracking-[0.18em] text-copper">
                    {p.category} · {p.readingTime}
                  </p>
                  <h3 class="mt-3 font-display text-[20px] font-normal leading-[1.3] text-ink">
                    <a href={`/blogs/${p.slug}`} class="transition-colors hover:text-copper">
                      {p.title}
                    </a>
                  </h3>
                  <p class="mt-3 font-display text-[15px] leading-[1.7] text-taupe">
                    {p.excerpt}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <SiteFooter />
  <FloatingCallButton />
</Layout>
