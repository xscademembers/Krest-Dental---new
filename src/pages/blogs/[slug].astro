---
import Layout from "@/layouts/Layout.astro";
import { FloatingCallButton } from "@/components/FloatingCallButton";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";
import { BLOG_POSTS } from "@/lib/krest-content";
import DrSuneetaHighlight from "@/components/DrSuneetaHighlight.astro";
import TextWithDrSuneetaHighlight from "@/components/TextWithDrSuneetaHighlight.astro";
import type { BlogPost } from "@/types/krest";

export const prerender = true;

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const canonical = `https://www.krest.dental/blogs/${post.slug}`;
const title = `${post.title} | Krest Dental`;
const description = post.excerpt;
const keywords = [post.category.toLowerCase(), "krest dental blog", "dentist visakhapatnam"];

const isDoctor = post.author.startsWith("Dr.");
const authorAvatar = isDoctor
  ? "/images/hero/dr-suneeta-portrait.jpg"
  : "/seo/favicon-192.png";

const sortedPosts = [...BLOG_POSTS].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const postIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = postIndex < sortedPosts.length - 1 ? sortedPosts[postIndex + 1] : null;
const nextPost = postIndex > 0 ? sortedPosts[postIndex - 1] : null;
const related = sortedPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => (b.category === post.category ? 1 : 0) - (a.category === post.category ? 1 : 0))
  .slice(0, 3);

const articleBody = [
  post.intro,
  ...post.sections.flatMap((s) => [s.heading ?? "", ...s.paragraphs]),
]
  .filter(Boolean)
  .join("\n\n");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  datePublished: post.date,
  description: post.excerpt,
  image: post.cover.src,
  url: canonical,
  articleBody,
  author: { "@type": isDoctor ? "Person" : "Organization", name: post.author },
  publisher: {
    "@type": "Organization",
    name: "Krest Dental",
    url: "https://www.krest.dental",
  },
  mainEntityOfPage: canonical,
};

const shareText = encodeURIComponent(post.title);
const shareUrl = encodeURIComponent(canonical);
---

<Layout {title} {description} {canonical} {keywords} ogType="article" ogImage={post.cover.src}>
  <SiteHeader client:load />
  <main class="flex-1 bg-cream">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <article>
      <!-- ARTICLE HEADER -->
      <header class="bg-[#F4EAE6] pb-12 pt-10 lg:pb-16 lg:pt-12">
        <div class="krest-site">
          <nav aria-label="Breadcrumb" class="flex justify-center">
            <ol class="flex flex-wrap items-center gap-2 font-body text-[12px] uppercase tracking-[0.16em] text-ink/55">
              <li><a href="/" class="transition-colors hover:text-copper">Home</a></li>
              <li aria-hidden="true">›</li>
              <li><a href="/blogs" class="transition-colors hover:text-copper">Blog</a></li>
              <li aria-hidden="true">›</li>
              <li class="text-copper">{post.category}</li>
            </ol>
          </nav>

          <h1 class="mx-auto mt-7 max-w-[900px] text-center font-display text-[34px] font-normal leading-[1.12] text-ink sm:text-[46px] lg:text-[54px]">
            {post.title}
          </h1>

          <p class="mx-auto mt-5 max-w-[680px] text-center font-display text-[17px] leading-[1.65] text-ink/70 sm:text-[19px]">
            {post.excerpt}
          </p>

          <div class="mt-8 flex items-center justify-center gap-4">
            <img
              src={authorAvatar}
              alt={post.author}
              class="h-12 w-12 rounded-full border border-copper/25 bg-white object-cover"
              width="48"
              height="48"
              loading="eager"
              decoding="async"
            />
            <div class="text-left">
              <p class="font-display text-[16px] leading-tight text-ink">{post.author}</p>
              <p class="mt-1 font-body text-[11px] uppercase tracking-[0.14em] text-ink/55">
                {dateFormatter.format(new Date(post.date))} · {post.readingTime}
              </p>
            </div>
          </div>
        </div>
      </header>

      <!-- COVER -->
      <div class="krest-site -mt-0 pt-10 lg:pt-12">
        <div class="mx-auto max-w-[1060px] overflow-hidden rounded-[30px] shadow-[0_30px_70px_-40px_rgba(76,69,59,0.55)]">
          <img
            src={post.cover.src}
            alt={post.cover.alt}
            class="aspect-[16/8] w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>

      <!-- BODY -->
      <div class="krest-site pb-14 pt-12 lg:pb-20 lg:pt-16">
        <div class="mx-auto max-w-[760px]">
          <p class="article-lead font-display text-[20px] leading-[1.75] text-ink sm:text-[22px]">
            <TextWithDrSuneetaHighlight text={post.intro} />
          </p>

          {post.sections.map((section, i) => (
            <>
              <section class="mt-10">
                {section.heading && (
                  <h2 class="flex items-baseline gap-4 font-display text-[26px] font-normal leading-[1.25] text-ink sm:text-[30px]">
                    <span aria-hidden="true" class="h-[2px] w-8 flex-none translate-y-[-6px] bg-copper"></span>
                    {section.heading}
                  </h2>
                )}
                {section.paragraphs.map((para) => (
                  <p class="mt-5 font-display text-[17px] leading-[1.85] text-ink/85 sm:text-[18px]">
                    <TextWithDrSuneetaHighlight text={para} />
                  </p>
                ))}
              </section>

              {post.quote && post.quote.afterSection === i + 1 && (
                <figure class="my-12 border-l-2 border-copper pl-7">
                  <blockquote class="font-display text-[22px] italic leading-[1.5] text-ink sm:text-[25px]">
                    “{post.quote.text}”
                  </blockquote>
                  <figcaption class="mt-4 font-accent text-[12px] uppercase tracking-[0.24em] text-copper">
                    {post.author}
                  </figcaption>
                </figure>
              )}
            </>
          ))}

          {post.takeaways && (
            <aside class="mt-12 rounded-[20px] bg-[#F4EAE6] p-7 lg:p-9" aria-label="Key takeaways">
              <h2 class="font-display text-[22px] font-normal text-ink sm:text-[24px]">
                Key takeaways
              </h2>
              <ul class="mt-5 space-y-3.5">
                {post.takeaways.map((item) => (
                  <li class="flex items-start gap-3.5 font-display text-[16px] leading-[1.6] text-ink/85 sm:text-[17px]">
                    <span class="mt-[7px] flex h-[10px] w-[10px] flex-none rounded-full border border-copper bg-copper/20" aria-hidden="true"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </aside>
          )}

          <!-- SHARE -->
          <div class="mt-12 flex flex-wrap items-center justify-between gap-5 border-t border-copper/15 pt-8">
            <p class="font-accent text-[12px] uppercase tracking-[0.24em] text-copper">
              Share this article
            </p>
            <div class="flex items-center gap-3">
              <a
                href={`https://wa.me/?text=${shareText}%20${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Share on WhatsApp"
                class="share-btn"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.8 1-.9 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.5-.3M12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.8-9.8a9.8 9.8 0 0 1 9.8 9.8c0 5.4-4.4 9.8-9.8 9.8m0-21.8C5.4 0 0 5.4 0 12c0 2.1.6 4.2 1.6 6L0 24l6.2-1.6c1.8 1 3.7 1.5 5.8 1.5 6.6 0 12-5.4 12-12S18.6 0 12 0" />
                </svg>
              </a>
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Share on Facebook"
                class="share-btn"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M13.5 21.9v-9h3l.5-3.5h-3.5V7.2c0-1 .3-1.7 1.7-1.7H17V2.3c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v2.7H7v3.5h3v9z" />
                </svg>
              </a>
              <a
                href={`https://x.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Share on X"
                class="share-btn"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="M18.9 1.2h3.7l-8.1 9.3L24 22.8h-7.5l-5.9-7.7-6.7 7.7H.2l8.6-9.9L0 1.2h7.7l5.3 7 6-7zm-1.3 19.4h2L6.6 3.3h-2.2z" />
                </svg>
              </a>
              <button type="button" data-copy-link aria-label="Copy link" class="share-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>
              </button>
              <span data-copy-feedback class="hidden font-body text-[12px] uppercase tracking-[0.12em] text-copper">
                Copied!
              </span>
            </div>
          </div>

          <!-- AUTHOR CARD -->
          <div class="mt-10 flex flex-col gap-6 rounded-[20px] bg-white p-7 shadow-[0_18px_44px_-32px_rgba(76,69,59,0.4)] sm:flex-row sm:items-center lg:p-8">
            <img
              src={authorAvatar}
              alt={post.author}
              class="h-20 w-20 flex-none rounded-full border border-copper/25 bg-cream object-cover"
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="font-accent text-[11px] uppercase tracking-[0.24em] text-copper">
                Written by
              </p>
              <p class="mt-2 font-display text-[20px] text-ink">
                {isDoctor ? <DrSuneetaHighlight class="font-display text-[20px] text-copper" tag="span" /> : post.author}
              </p>
              {isDoctor ? null : (
                <p class="mt-1 font-display text-[15px] italic text-ink/65">{post.authorRole}</p>
              )}
              {isDoctor && (
                <a
                  href="/drsuneeta"
                  class="mt-3 inline-flex items-center gap-2 font-display text-[15px] text-copper transition-colors hover:text-ink"
                >
                  More about <DrSuneetaHighlight class="font-display text-[15px]" />
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="M13 5l7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>
          </div>

          <!-- PREV / NEXT -->
          <nav class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2" aria-label="More articles">
            {prevPost ? (
              <a
                href={`/blogs/${prevPost.slug}`}
                class="group rounded-[20px] border border-copper/20 bg-white/60 p-6 transition-colors hover:bg-white"
              >
                <p class="font-body text-[11px] uppercase tracking-[0.18em] text-ink/55">
                  ← Older article
                </p>
                <p class="mt-3 font-display text-[17px] leading-[1.35] text-ink transition-colors group-hover:text-copper">
                  {prevPost.title}
                </p>
              </a>
            ) : (
              <span></span>
            )}
            {nextPost && (
              <a
                href={`/blogs/${nextPost.slug}`}
                class="group rounded-[20px] border border-copper/20 bg-white/60 p-6 text-right transition-colors hover:bg-white"
              >
                <p class="font-body text-[11px] uppercase tracking-[0.18em] text-ink/55">
                  Newer article →
                </p>
                <p class="mt-3 font-display text-[17px] leading-[1.35] text-ink transition-colors group-hover:text-copper">
                  {nextPost.title}
                </p>
              </a>
            )}
          </nav>
        </div>
      </div>
    </article>

    <!-- RELATED -->
    {related.length > 0 && (
      <section class="bg-[#F4EAE6] py-14 lg:py-20" aria-label="Related posts">
        <div class="krest-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="font-accent text-[12px] uppercase tracking-[0.28em] text-copper">
                Continue reading
              </p>
              <h2 class="mt-3 font-display text-[28px] font-normal leading-tight text-ink sm:text-[34px]">
                More from the journal
              </h2>
            </div>
            <a
              href="/blogs"
              class="inline-flex h-10 items-center rounded-full border border-copper px-5 font-display text-[15px] text-copper transition-colors hover:bg-copper hover:text-white"
            >
              View all articles
            </a>
          </div>
          <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
            {related.map((p) => (
              <article class="group flex h-full flex-col overflow-hidden rounded-[20px] bg-white shadow-[0_18px_44px_-32px_rgba(76,69,59,0.4)] transition duration-300 hover:-translate-y-1.5">
                <a href={`/blogs/${p.slug}`} class="relative block">
                  <div class="relative aspect-[16/10] w-full overflow-hidden">
                    <img
                      src={p.cover.src}
                      alt={p.cover.alt}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <span class="absolute left-4 top-4 inline-flex items-center rounded-full bg-white/95 px-3.5 py-1 font-display text-[12px] tracking-[0.04em] text-copper">
                    {p.category}
                  </span>
                </a>
                <div class="flex flex-1 flex-col px-6 pb-7 pt-5">
                  <p class="font-body text-[11px] uppercase tracking-[0.18em] text-ink/55">
                    {dateFormatter.format(new Date(p.date))} · {p.readingTime}
                  </p>
                  <h3 class="mt-3 font-display text-[20px] font-normal leading-[1.3] text-ink">
                    <a href={`/blogs/${p.slug}`} class="transition-colors hover:text-copper">
                      {p.title}
                    </a>
                  </h3>
                  <p class="mt-3 font-display text-[15px] leading-[1.65] text-ink/70">
                    {p.excerpt}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="krest-site py-14 lg:py-16" aria-label="Book a consultation">
      <div class="flex flex-col items-center justify-between gap-6 rounded-[30px] bg-copper px-8 py-10 text-center sm:flex-row sm:text-left lg:px-14">
        <div>
          <h2 class="font-display text-[26px] font-normal leading-[1.2] text-white sm:text-[30px]">
            Ready to talk about your smile?
          </h2>
          <p class="mt-2 font-display text-[16px] text-white/85">
            Book a consultation with <DrSuneetaHighlight class="font-display text-[16px] text-white" /> in Visakhapatnam.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex h-[50px] flex-none items-center gap-4 rounded-[50px] bg-white pl-[22px] pr-[10px] font-display text-[17px] tracking-[0.04em] text-copper transition-opacity hover:opacity-90"
        >
          Book Appointment
          <span class="flex h-[26px] w-[26px] items-center justify-center rounded-full bg-copper text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="M13 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter mobileWhiteBg />
  <FloatingCallButton />
</Layout>

<style>
  .article-lead::first-letter {
    float: left;
    margin-right: 0.12em;
    font-size: 3.2em;
    line-height: 0.85;
    color: #9f6449;
  }
  .share-btn {
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid #9f6449;
    color: #9f6449;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .share-btn:hover {
    background-color: #9f6449;
    color: #ffffff;
  }
</style>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  const feedback = document.querySelector<HTMLElement>("[data-copy-feedback]");
  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      feedback?.classList.remove("hidden");
      setTimeout(() => feedback?.classList.add("hidden"), 2000);
    } catch {
      /* clipboard unavailable */
    }
  });
</script>
