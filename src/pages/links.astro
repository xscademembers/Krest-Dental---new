---
import Layout from "@/layouts/Layout.astro";
import { FloatingCallButton } from "@/components/FloatingCallButton";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";

export const prerender = true;

const canonical = "https://www.krest.dental/links";
const title = "Connect With Us | Krest Dental";
const description =
  "Quick links to Krest Dental's social media, reviews, and website. Follow Dr. Suneeta Veeramachaneni on Instagram, Facebook, YouTube, and more.";
const keywords = ["krest dental links", "dr suneeta social media", "krest dental reviews"];

const LINK_ITEMS = [
  {
    label: "Instagram",
    href: "https://www.instagram.com/krestdental/",
    icon: "instagram",
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/krestdentalcare",
    icon: "facebook",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@krestdental",
    icon: "youtube",
  },
  {
    label: "Practo Reviews",
    href: "https://www.practo.com/visakhapatnam/doctor/dr-suneeta-veeramachaneni-dentist",
    icon: "practo",
  },
  {
    label: "Google Reviews",
    href: "https://g.page/r/CUE6gNyLRCGdEBM/review",
    icon: "google",
  },
  {
    label: "Website",
    href: "https://www.krest.dental/",
    icon: "globe",
  },
];

const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(
  "Krest Dental Care MVP Colony Visakhapatnam 530017",
)}&output=embed`;
---

<Layout {title} {description} {canonical} {keywords}>
  <SiteHeader client:load />
  <main class="flex-1">
    <!-- Hero section: white bg with blush top band, portrait overlapping both -->
    <section class="relative bg-white pb-8 pt-0 md:py-10 lg:min-h-[400px] lg:py-0">
      <!-- Mobile hero image band — Wix: 375×259, stretch, 0 padding -->
      <div class="absolute inset-x-0 top-0 h-[259px] overflow-hidden md:hidden">
        <img
          src="/images/about/reception.jpg"
          alt="Krest Dental Care clinic reception and front desk"
          class="h-full w-full object-cover"
          width={786}
          height={506}
          loading="eager"
        />
      </div>

      <!-- Blush top band — tablet/desktop only -->
      <div class="absolute inset-x-0 top-0 hidden h-[140px] bg-[#F4EAE6] md:block lg:h-[184px]"></div>

      <!-- Content centered -->
      <div class="relative mx-auto flex w-full max-w-[700px] flex-col items-center px-0 text-center md:justify-center md:px-[25px] lg:min-h-[400px]">
        <!-- Circular portrait — Wix mobile: fixed 200×200 at y=150 -->
        <div class="mt-[150px] h-[200px] w-[200px] shrink-0 overflow-hidden rounded-full border-[10px] border-white md:mt-5 md:h-[170px] md:w-[170px] md:border-[8px] lg:mt-5 lg:h-[200px] lg:w-[200px] lg:border-[10px]">
          <img
            src="/images/dr-suneeta/dsc08627.jpg"
            alt="Dr. Suneeta Veeramachaneni"
            class="h-full w-full object-cover"
            style="object-position: 50% 25%;"
            width="180"
            height="180"
            loading="eager"
          />
        </div>

        <!-- Wix mobile stack: name + credentials, vertical centered -->
        <div class="links-mobile-stack mt-10 flex w-full flex-col items-center gap-[10px] px-[25px] md:contents md:gap-0 md:px-0">
          <h1 class="w-full text-center font-body text-[24px] font-bold leading-[1.4] text-copper md:mt-5 md:text-[22px] lg:text-[24px]">
            Dr. Suneeta Veeramachaneni
          </h1>
          <p class="w-full text-center font-body text-[18px] font-light leading-[1.4] text-black md:mt-2 md:max-w-none md:text-[16px] lg:text-[18px]">
            Bachelor of Dental Surgery (BDS), Manipal University
          </p>
          <p class="w-full text-center font-body text-[18px] font-light leading-[1.4] text-black md:mt-1 md:max-w-none md:text-[16px] lg:text-[18px]">
            Doctor of Dental Surgery (DDS), University of California, San Francisco
          </p>
        </div>
      </div>
    </section>

    <!-- Link buttons section -->
    <section class="bg-white pb-6 pt-10 md:py-10 lg:py-14">
      <div class="px-4 md:krest-site md:px-[25px]">
        <div class="links-mobile-buttons mx-auto flex w-[306px] max-w-full flex-col items-stretch gap-[25px] md:w-full md:max-w-[390px] md:gap-3 lg:gap-4">
        {LINK_ITEMS.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="links-mobile-btn relative flex h-[60px] w-full items-center rounded-[10px] bg-[#f0f0f0] pr-2 transition-all hover:bg-[#e8e8e8] md:h-[56px] md:justify-between md:pl-5 md:pr-[10px] lg:h-[60px]"
          >
            <!-- Icon -->
            <span class="absolute left-4 top-1/2 z-10 flex h-[33px] w-[33px] -translate-y-1/2 shrink-0 items-center justify-center text-copper md:static md:translate-y-0 md:h-[30px] md:w-[30px] lg:h-[33px] lg:w-[33px]">
              {item.icon === "instagram" && (
                <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162 0 3.403 2.759 6.163 6.162 6.163 3.403 0 6.162-2.759 6.162-6.163 0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              )}
              {item.icon === "facebook" && (
                <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692V11.07h3.128V8.412c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.464.099 2.795.143v3.24h-1.918c-1.504 0-1.795.715-1.795 1.762v2.31h3.587l-.467 3.622h-3.12V24h6.116c.733 0 1.325-.593 1.325-1.325V1.325C24 .593 23.408 0 22.675 0z" />
                </svg>
              )}
              {item.icon === "youtube" && (
                <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              )}
              {item.icon === "practo" && (
                <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <text x="2" y="18" font-size="16" font-weight="bold" font-family="sans-serif">•P•</text>
                </svg>
              )}
              {item.icon === "google" && (
                <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              )}
              {item.icon === "globe" && (
                <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              )}
            </span>

            <!-- Label -->
            <span class="links-mobile-label min-w-0 flex-1 pl-[58px] text-left font-body text-[18px] font-light leading-[1.4] text-black md:pointer-events-none md:absolute md:inset-x-0 md:z-0 md:flex-none md:pl-0 md:text-center md:text-[17px] lg:text-[18px]">
              {item.label}
            </span>

            <!-- Go arrow button -->
            <span class="relative z-10 ml-auto flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-[5px] bg-copper text-white md:ml-0 md:h-[40px] md:w-[40px] lg:h-[42px] lg:w-[42px]">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
        </div>
      </div>
    </section>

    <!-- Map section (blush background) -->
    <section class="bg-[#F4EAE6] py-8 sm:py-10 lg:py-14">
      <div class="krest-site">
        <div class="overflow-hidden rounded-[8px]">
          <iframe
            title="Krest Dental — map location"
            src={mapEmbedUrl}
            class="h-[280px] w-full border-0 sm:h-[380px] md:h-[420px] lg:h-[500px] xl:h-[557px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <FloatingCallButton />
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap");

  @media (max-width: 767px) {
    .links-mobile-stack h1,
    .links-mobile-stack p,
    .links-mobile-label {
      font-family: "Roboto", var(--font-body);
    }

    .links-mobile-stack h1 {
      font-weight: 700;
    }

    .links-mobile-stack h1,
    .links-mobile-stack p {
      text-align: center;
    }

    .links-mobile-btn {
      max-width: 306px;
    }
  }

  @media (min-width: 768px) {
    .links-mobile-label {
      text-align: center;
    }
  }
</style>
