---
import Layout from "@/layouts/Layout.astro";
import { FloatingCallButton } from "@/components/FloatingCallButton";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";
import { BLOG_POSTS } from "@/lib/krest-content";

export const prerender = true;

const canonical = "https://www.krest.dental/blogs";
const title = "Blog | Krest Dental Vizag";
const description =
  "Notes from the Krest Dental team — patient guides, treatment explainers, and behind-the-scenes posts on cosmetic, implant, and general dentistry in Visakhapatnam.";
const keywords = [
  "krest dental blog",
  "dentist visakhapatnam blog",
  "dental care articles",
  "implants invisalign guide",
];

const dateFormatter = new Intl.DateTimeFormat("en-IN", {
  day: "numeric",
  month: "short",
  year: "numeric",
});

const posts = [...BLOG_POSTS].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const [featured, ...rest] = posts;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Krest Dental Blog",
  url: canonical,
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.title,
    datePublished: p.date,
    url: `${canonical}/${p.slug}`,
    image: p.cover.src,
    description: p.excerpt,
  })),
};
---

<Layout {title} {description} {canonical} {keywords}>
  <SiteHeader client:load />
  <main class="flex-1 bg-cream">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <section
      class="bg-[#F4EAE7] pb-12 pt-12 lg:pb-16 lg:pt-16"
      aria-label="Blog header"
    >
      <div class="krest-site text-center">
        <p class="font-accent text-[12px] uppercase tracking-[0.28em] text-copper">
          From the chair
        </p>
        <h1
          class="mt-3 font-display text-[40px] font-normal leading-tight text-ink sm:text-[52px] lg:text-[58px]"
        >
          Krest Dental Journal
        </h1>
        <p
          class="mx-auto mt-5 max-w-[640px] font-display text-[16px] leading-[1.7] text-taupe sm:text-[17px]"
        >
          Patient guides, treatment explainers, and behind-the-scenes notes from Dr. Suneeta and the team in Visakhapatnam.
        </p>
      </div>
    </section>

    <section class="krest-site py-14 lg:py-20" aria-label="Featured post">
      <a
        href={`/blogs/${featured.slug}`}
        class="group grid grid-cols-1 gap-8 overflow-hidden rounded-[24px] bg-white shadow-[0_18px_50px_-28px_rgba(0,0,0,0.25)] transition lg:grid-cols-[1.1fr_0.9fr] lg:gap-12"
      >
        <div class="relative aspect-[16/10] w-full overflow-hidden lg:aspect-auto lg:h-full">
          <img
            src={featured.cover.src}
            alt={featured.cover.alt}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <div class="flex flex-col justify-center px-6 pb-10 lg:px-10 lg:py-12">
          <p class="font-accent text-[12px] uppercase tracking-[0.18em] text-copper">
            {featured.category} · {featured.readingTime}
          </p>
          <h2
            class="mt-4 font-display text-[28px] font-normal leading-[1.2] text-ink sm:text-[34px] lg:text-[36px]"
          >
            {featured.title}
          </h2>
          <p class="mt-5 font-display text-[16px] leading-[1.7] text-taupe sm:text-[17px]">
            {featured.excerpt}
          </p>
          <div class="mt-8 flex items-center gap-4">
            <span
              class="inline-flex items-center gap-3 rounded-full bg-copper px-5 py-2 font-display text-[14px] tracking-wide text-white transition group-hover:bg-copper/90"
            >
              Read article
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-3.5 w-3.5"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="M13 5l7 7-7 7" />
              </svg>
            </span>
            <span class="font-body text-[13px] uppercase tracking-[0.16em] text-taupe">
              {dateFormatter.format(new Date(featured.date))}
            </span>
          </div>
        </div>
      </a>
    </section>

    <section
      class="krest-site pb-20 lg:pb-28"
      aria-label="All blog posts"
    >
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-12">
        {rest.map((post) => (
          <article
            class="flex h-full flex-col overflow-hidden rounded-[20px] bg-white shadow-[0_14px_38px_-26px_rgba(0,0,0,0.22)] transition hover:-translate-y-1 hover:shadow-[0_22px_50px_-26px_rgba(0,0,0,0.28)]"
          >
            <a href={`/blogs/${post.slug}`} class="group block">
              <div class="relative aspect-[16/10] w-full overflow-hidden">
                <img
                  src={post.cover.src}
                  alt={post.cover.alt}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </a>
            <div class="flex flex-1 flex-col px-6 pb-7 pt-6 lg:px-7">
              <p class="font-accent text-[11px] uppercase tracking-[0.18em] text-copper">
                {post.category} · {post.readingTime}
              </p>
              <h2 class="mt-3 font-display text-[22px] font-normal leading-[1.25] text-ink sm:text-[24px]">
                <a
                  href={`/blogs/${post.slug}`}
                  class="transition-colors hover:text-copper"
                >
                  {post.title}
                </a>
              </h2>
              <p class="mt-4 font-display text-[15px] leading-[1.7] text-taupe sm:text-[16px]">
                {post.excerpt}
              </p>
              <div class="mt-auto flex items-center justify-between pt-6">
                <span class="font-body text-[12px] uppercase tracking-[0.16em] text-taupe">
                  {dateFormatter.format(new Date(post.date))}
                </span>
                <a
                  href={`/blogs/${post.slug}`}
                  class="inline-flex items-center gap-2 font-display text-[14px] text-copper transition-colors hover:text-ink"
                >
                  Read more
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-3 w-3"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="M13 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
  <FloatingCallButton />
</Layout>
