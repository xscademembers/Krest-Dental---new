# ──────────────────────────────────────────────────────────
# Public site URL (used by SEO + form redirect; no trailing slash)
# ──────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://www.krest.dental

# ──────────────────────────────────────────────────────────
# Lead storage — MongoDB (Atlas connection string)
# Server-only; do NOT prefix with PUBLIC_
# ──────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=krest
MONGODB_COLLECTION_LEADS=leads

# Optional — comma-separated DNS servers Node uses for mongodb+srv SRV lookups.
# If you see: querySrv ECONNREFUSED _mongodb._tcp...  set this (or rely on the dev default).
# Example: 8.8.8.8,1.1.1.1
# MONGODB_DNS_SERVERS=

# ──────────────────────────────────────────────────────────
# Admin panel credentials (for /admin sign-in)
# Change these before going live.
# ──────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Long random string — used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-hex-string

# ──────────────────────────────────────────────────────────
# Vercel (Production / Preview)
# Project → Settings → Environment Variables — add the same keys as above.
# Builds on Vercel set VERCEL=1 automatically; astro.config uses @astrojs/vercel
# so /admin and /api/* work as serverless routes (Node adapter is for self-host only).
#
# Vercel previews use https://<name>.vercel.app while this may point at a custom domain.
# astro.config sets security.checkOrigin false so form POSTs (contact, /admin login) are not 403'd
# when the browser host and this value differ. Keep this equal to the primary public URL when possible.
# ──────────────────────────────────────────────────────────
